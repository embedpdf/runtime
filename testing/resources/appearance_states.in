% A check box that is off, with normal, down and rollover states. Each state
% fills the box with its own colour: normal Yes red, normal Off green, down
% Yes blue, down Off yellow, rollover Yes black. The rollover dictionary also
% holds an entry that is not a stream, which is no state.
{{object 5 0}} <<
  /Type /Annot
  /Subtype /Widget
  /FT /Btn
  /T (states)
  /V /Off
  /AS /Off
  /F 4
  /Rect [20 20 60 60]
  /AP <<
    /N << /Yes 6 0 R /Off 7 0 R >>
    /D << /Yes 8 0 R /Off 11 0 R >>
    /R << /Yes 12 0 R /Bad 5 >>
  >>
>>
endobj
{{object 6 0}} <<
  /Type /XObject
  /Subtype /Form
  /BBox [0 0 40 40]
  {{streamlen}}
>>
stream
1 0 0 rg 0 0 40 40 re f
endstream
endobj
{{object 7 0}} <<
  /Type /XObject
  /Subtype /Form
  /BBox [0 0 40 40]
  {{streamlen}}
>>
stream
0 1 0 rg 0 0 40 40 re f
endstream
endobj
{{object 8 0}} <<
  /Type /XObject
  /Subtype /Form
  /BBox [0 0 40 40]
  {{streamlen}}
>>
stream
0 0 1 rg 0 0 40 40 re f
endstream
endobj
