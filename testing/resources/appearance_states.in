% Toggles with no appearance yet, for the generators. A check box showing a
% blue cross (/CA 8).
{{object 15 0}} <<
  /Type /Annot
  /Subtype /Widget
  /FT /Btn
  /T (cross)
  /V /Off
  /DA (0 0 1 rg)
  /MK << /CA (8) >>
  /Rect [20 100 60 140]
>>
endobj
% A radio button showing a red square (/CA n), in a black box.
{{object 16 0}} <<
  /Type /Annot
  /Subtype /Widget
  /FT /Btn
  /Ff 32768
  /T (square)
  /V /Off
  /DA (1 0 0 rg)
  /MK << /CA (n) /BC [0 0 0] >>
  /Rect [100 100 140 140]
>>
endobj
