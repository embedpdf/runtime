{{header}}
{{object 1 0}} <<
  /Type /Catalog
  /Pages 2 0 R
>>
endobj
{{object 2 0}} <<
  /Type /Pages
  /MediaBox [0 0 200 200]
  /Count 3
  /Kids [3 0 R 4 0 R 5 0 R]
>>
endobj
% A tiling pattern whose one cell is larger than the area it fills, the way
% Chrome prints a CSS background.
{{object 3 0}} <<
  /Type /Page
  /Parent 2 0 R
  /Resources <<
    /Pattern << /P1 10 0 R >>
  >>
  /Contents 6 0 R
>>
endobj
% A tiling pattern of small cells.
{{object 4 0}} <<
  /Type /Page
  /Parent 2 0 R
  /Resources <<
    /Pattern << /P2 11 0 R >>
  >>
  /Contents 7 0 R
>>
endobj
% A Type3 glyph that draws a rectangle and the image.
{{object 5 0}} <<
  /Type /Page
  /Parent 2 0 R
  /Resources <<
    /Font << /F1 12 0 R >>
  >>
  /Contents 8 0 R
>>
endobj
{{object 6 0}} <<
  {{streamlen}}
>>
stream
/Pattern cs /P1 scn
20 20 160 160 re f
endstream
endobj
{{object 7 0}} <<
  {{streamlen}}
>>
stream
/Pattern cs /P2 scn
0 0 200 200 re f
endstream
endobj
{{object 8 0}} <<
  {{streamlen}}
>>
stream
BT
/F1 100 Tf
50 50 Td
(a) Tj
ET
endstream
endobj
% Red and green on top, blue and yellow below.
{{object 9 0}} <<
  /Type /XObject
  /Subtype /Image
  /Width 2
  /Height 2
  /ColorSpace /DeviceRGB
  /BitsPerComponent 8
  /Filter /ASCIIHexDecode
  {{streamlen}}
>>
stream
FF0000 00FF00 0000FF FFFF00>
endstream
endobj
{{object 10 0}} <<
  /Type /Pattern
  /PatternType 1
  /PaintType 1
  /TilingType 1
  /BBox [0 0 200 200]
  /XStep 202
  /YStep 202
  /Resources <<
    /XObject << /Im1 9 0 R >>
  >>
  {{streamlen}}
>>
stream
q 200 0 0 200 0 0 cm /Im1 Do Q
endstream
endobj
{{object 11 0}} <<
  /Type /Pattern
  /PatternType 1
  /PaintType 1
  /TilingType 1
  /BBox [0 0 20 20]
  /XStep 20
  /YStep 20
  /Resources <<
    /XObject << /Im1 9 0 R >>
  >>
  {{streamlen}}
>>
stream
q 20 0 0 20 0 0 cm /Im1 Do Q
endstream
endobj
{{object 12 0}} <<
  /Type /Font
  /Subtype /Type3
  /FontBBox [0 0 1000 1000]
  /FontMatrix [0.001 0 0 0.001 0 0]
  /FirstChar 97
  /LastChar 97
  /Widths [1000]
  /Encoding <<
    /Type /Encoding
    /Differences [97 /a]
  >>
  /CharProcs << /a 13 0 R >>
  /Resources <<
    /XObject << /Im1 9 0 R >>
  >>
>>
endobj
{{object 13 0}} <<
  {{streamlen}}
>>
stream
1000 0 d0
0 0 500 1000 re f
q 500 0 0 1000 500 0 cm /Im1 Do Q
endstream
endobj
