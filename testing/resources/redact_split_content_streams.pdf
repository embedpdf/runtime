endstream
endobj
% Page 1: a stream cut inside q ... cm ... Q where the cm cannot be inverted
% (a strip of no height). Nothing after it can be drawn by undoing that CTM.
20 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 300 200]
  /Resources << /Font << /F1 3 0 R >> >>
  /Contents [21 0 R 22 0 R 23 0 R] >>
endobj
