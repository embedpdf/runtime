% a: its object reference comes after a marked-content kid.
{{object 30 0}} <<
  /Type /StructElem
  /S /Form
  /P 12 0 R
  /Pg 3 0 R
  /K [1 << /Type /OBJR /Obj 20 0 R >>]
>>
endobj
% b: /K is the object reference itself, not an array.
{{object 31 0}} <<
  /Type /StructElem
  /S /Form
  /P 13 0 R
  /K << /Type /OBJR /Pg 3 0 R /Obj 21 0 R >>
>>
endobj
% c
