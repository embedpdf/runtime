% A check box that is on, its on state a UTF-8 name: "S" and an i with an
% acute accent, written with # escapes. Red when on, green when off.
19 0 obj <<
  /Type /Annot
  /Subtype /Widget
  /FT /Btn
  /T (si)
  /V /S#C3#AD
  /AS /S#C3#AD
  /Rect [220 20 260 60]
  /AP << /N << /S#C3#AD 6 0 R /Off 7 0 R >> >>
>>
endobj
