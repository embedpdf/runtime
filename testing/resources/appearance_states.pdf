  /Type /Annot
  /Subtype /Widget
  /FT /Btn
  /Ff 32768
  /T (square)
  /V /Off
  /DA (1 0 0 rg)
  /MK << /CA (n) /BC [0 0 0] >>
  /Rect [100 100 140 140]
>>
endobj
